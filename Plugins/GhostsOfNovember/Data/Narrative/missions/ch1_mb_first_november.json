    "ar": "الأول من نوفمبر",
    "en": "The First of November"
  },
  "design": {
    "visibleGoal": "الفوج المختار (مقاتلون خياليون) ينفّذ مهمته في البلدة ثم يلتحق بنقطة التجمع قبل الفجر؛ بن بولعيد يقدّم الإحاطة فقط.",
    "dramaticGoal": "إظهار أن العمليات بدأت في مناطق متعددة لا في موقع واحد، بموارد قليلة.",
    "obstacle": "سلاح نادر، تنسيق بين ثلاثة أفواج، ووقت ضيق.",
    "decision": "اختيار الفوج (الدرك، محطة الكهرباء، الشرطة).",
    "consequence": "تتغير الموارد والشك في المنطقة وحالة الشبكة.",
    "transition": "الانسحاب نحو الجبل."
  },
